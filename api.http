GET {{baseUrl}}/api/loans/
Authorization: Bearer {{authToken}}

### Get all loans - Without authentication (should fail with 401)
GET {{baseUrl}}/api/loans/

###############################################
# OAUTH2 ENDPOINTS
###############################################

### Initiate Google OAuth2 login
# Note: This will redirect to Google login page
# After successful login, you'll be redirected to the frontend callback URL with the token
GET {{baseUrl}}/oauth2/authorization/google

### OAuth2 callback endpoint (handled automatically by Spring Security)
# GET {{baseUrl}}/login/oauth2/code/google

###############################################
# SWAGGER/OPENAPI DOCUMENTATION
###############################################

### Get OpenAPI documentation (JSON)
GET {{baseUrl}}/v3/api-docs

### Get OpenAPI documentation (YAML)
GET {{baseUrl}}/v3/api-docs.yaml

### Access Swagger UI
GET {{baseUrl}}/swagger-ui/index.html

###############################################
# TESTING WORKFLOW
###############################################

### Quick Testing Workflow:
### 1. Use "Register a new user" endpoint above to create an account
### 2. Use "Login with username and password" or "Login as admin" above to get JWT token
### 3. Token is automatically saved and can be used for protected endpoints
### 4. Test protected endpoints like GET /api/books below

