PUT {{baseUrl}}/api/user/update-profile
Content-Type: application/json

{
  "email": "test@example.com"
}

###############################################
# LOAN ENDPOINTS (Requires Authentication)
###############################################

### Borrow a book
POST {{baseUrl}}/api/loans/borrow
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "bookId": 5
}

### Borrow a book - Another example
POST {{baseUrl}}/api/loans/borrow
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "bookId": 2
}

### Borrow a book - Non-existent book (should return 404)
POST {{baseUrl}}/api/loans/borrow
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "bookId": 999
}

### Borrow a book - Book with no available copies (should return error)
POST {{baseUrl}}/api/loans/borrow
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "bookId": 1
}

### Borrow a book - Without authentication (should fail with 401)
POST {{baseUrl}}/api/loans/borrow
Content-Type: application/json

{
  "bookId": 1
}

### Return a borrowed book
POST {{baseUrl}}/api/loans/return
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "loanId": 2
}

### Return a borrowed book - Another example
POST {{baseUrl}}/api/loans/return
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "loanId": 2
}

### Return a borrowed book - Non-existent loan (should return 404)
POST {{baseUrl}}/api/loans/return
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "loanId": 999
}

### Return a borrowed book - Already returned (should return error)
POST {{baseUrl}}/api/loans/return
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "loanId": 1
}

### Return a borrowed book - Without authentication (should fail with 401)
POST {{baseUrl}}/api/loans/return
Content-Type: application/json

{
  "loanId": 1
}

### Get my loans (paginated)
GET {{baseUrl}}/api/loans/my-loans
Authorization: Bearer {{authToken}}

### Get my loans - With pagination
GET {{baseUrl}}/api/loans/my-loans?page=0&size=5
Authorization: Bearer {{authToken}}

### Get my loans - With sorting
GET {{baseUrl}}/api/loans/my-loans?sortBy=borrowDate&sortDir=desc
Authorization: Bearer {{authToken}}

### Get my loans - With pagination and sorting
GET {{baseUrl}}/api/loans/my-loans?page=0&size=10&sortBy=dueDate&sortDir=asc
Authorization: Bearer {{authToken}}

### Get my loans - Filter by status: all (default)
GET {{baseUrl}}/api/loans/my-loans?status=all
Authorization: Bearer {{authToken}}

### Get my loans - Filter by status: active (not returned)
GET {{baseUrl}}/api/loans/my-loans?status=active
Authorization: Bearer {{authToken}}

### Get my loans - Filter by status: returned
GET {{baseUrl}}/api/loans/my-loans?status=returned
Authorization: Bearer {{authToken}}

### Get my loans - Filter by status: overdue
GET {{baseUrl}}/api/loans/my-loans?status=overdue
Authorization: Bearer {{authToken}}

### Get my loans - With status filter, pagination and sorting
GET {{baseUrl}}/api/loans/my-loans?status=active&page=0&size=5&sortBy=dueDate&sortDir=asc
Authorization: Bearer {{authToken}}

### Get my loans - Without authentication (should fail with 401)
GET {{baseUrl}}/api/loans/my-loans

