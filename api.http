### VS Code REST Client Configuration
### Install the REST Client extension: https://marketplace.visualstudio.com/items?itemName=humao.rest-client

@baseUrl = http://localhost:8080
@token = eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJhZG1pbkBleGFtcGxlLmNvbSIsImlhdCI6MTc2NDg1NTU4NywiZXhwIjoxNzY0OTQxOTg3fQ.S0IHt9RVH47ixPQOLKbp3_Bmm-3fYd-oF5e_Bw4UBQI

### Variables - Token is automatically extracted after login
@authToken = {{token}}

###############################################
# AUTHENTICATION ENDPOINTS
###############################################

### Register a new user
POST {{baseUrl}}/api/auth/signup
Content-Type: application/json

{
  "username": "testuser",
  "email": "test@example.com",
  "password": "password123",
  "role": ["ROLE_USER"]
}

### Register a new admin user
POST {{baseUrl}}/api/auth/signup
Content-Type: application/json

{
  "username": "admin",
  "email": "admin@example.com",
  "password": "admin123",
  "role": ["ROLE_ADMIN"]
}

### Login with username and password
# @name login
POST {{baseUrl}}/api/auth/signin
Content-Type: application/json

{
  "username": "testuser",
  "password": "password123"
}

> {%
    if (response.status === 200) {
        client.global.set("token", response.body.token);
        client.log("✅ Token automatically saved: " + response.body.token.substring(0, 20) + "...");
    } else {
        client.log("❌ Login failed: " + response.status);
    }
%}

### Login as admin
# @name adminLogin
POST {{baseUrl}}/api/auth/signin
Content-Type: application/json

{
  "username": "admin",
  "password": "admin123"
}

> {%
    if (response.status === 200) {
        client.global.set("token", response.body.token);
        client.log("✅ Token automatically saved: " + response.body.token.substring(0, 20) + "...");
    } else {
        client.log("❌ Login failed: " + response.status);
    }
%}

###############################################
# BOOK ENDPOINTS (Requires Authentication)
###############################################

### Get all books (default pagination)
GET {{baseUrl}}/api/books
Authorization: Bearer {{authToken}}

### Get books with pagination - Page 0, Size 5
GET {{baseUrl}}/api/books?page=0&size=5
Authorization: Bearer {{authToken}}

### Get books with pagination - Page 1, Size 10
GET {{baseUrl}}/api/books?page=1&size=10
Authorization: Bearer {{authToken}}

### Get books sorted by ID descending
GET {{baseUrl}}/api/books?sortBy=id&sortDir=desc
Authorization: Bearer {{authToken}}

### Get books sorted by title ascending
GET {{baseUrl}}/api/books?sortBy=title&sortDir=asc
Authorization: Bearer {{authToken}}

### Get books with custom pagination and sorting
GET {{baseUrl}}/api/books?page=0&size=20&sortBy=id&sortDir=desc
Authorization: Bearer {{authToken}}

###############################################
# BOOK ADMIN ENDPOINTS (Requires ADMIN Role)
###############################################

### Create a new book (Admin only)
POST {{baseUrl}}/api/books
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "title": "Clean Code",
  "author": "Robert C. Martin",
  "isbn": "978-0132350884",
  "category": "Programming",
  "totalCopies": "10",
  "availableCopies": "10",
  "coverImage": "https://example.com/clean-code.jpg"
}

### Create a new book - Minimal fields (availableCopies defaults to totalCopies)
POST {{baseUrl}}/api/books
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "title": "Design Patterns",
  "author": "Gang of Four",
  "isbn": "978-0201633610",
  "category": "Software Engineering",
  "totalCopies": "5"
}

### Create a new book - Without admin role (should fail with 403)
# First login as a regular user (not admin), then try this:
POST {{baseUrl}}/api/books
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "title": "Test Book",
  "author": "Test Author",
  "isbn": "978-0000000000",
  "totalCopies": "1"
}

### Update book - Full update (Admin only)
PUT {{baseUrl}}/api/books/1
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "title": "Clean Code: A Handbook of Agile Software Craftsmanship",
  "author": "Robert C. Martin",
  "isbn": "978-0132350884",
  "category": "Software Development",
  "totalCopies": "15",
  "availableCopies": "12",
  "coverImage": "https://example.com/clean-code-updated.jpg"
}

### Update book - Partial update (only some fields)
PUT {{baseUrl}}/api/books/1
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "title": "Updated Book Title",
  "availableCopies": "8"
}

### Update book - Non-existent book (should return 404)
PUT {{baseUrl}}/api/books/999
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "title": "This Book Doesn't Exist",
  "author": "Unknown Author",
  "isbn": "978-0000000000",
  "totalCopies": "1"
}

### Update book - Without admin role (should fail with 403)
# First login as a regular user (not admin), then try this:
PUT {{baseUrl}}/api/books/1
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "title": "Unauthorized Update",
  "author": "Hacker"
}

### Update book stock - Update available copies (Admin only)
PUT {{baseUrl}}/api/books/1/stock
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "availableCopies": "5"
}

### Update book stock - Increase available copies
PUT {{baseUrl}}/api/books/1/stock
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "availableCopies": "15"
}

### Update book stock - Set to zero
PUT {{baseUrl}}/api/books/1/stock
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "availableCopies": "0"
}

### Update book stock - Non-existent book (should return 404)
PUT {{baseUrl}}/api/books/999/stock
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "availableCopies": "10"
}

### Update book stock - Without admin role (should fail with 403)
# First login as a regular user (not admin), then try this:
PUT {{baseUrl}}/api/books/1/stock
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "availableCopies": "10"
}

### Delete book (Admin only)
DELETE {{baseUrl}}/api/books/6
Authorization: Bearer {{authToken}}

### Delete book - Non-existent book (should return 404)
DELETE {{baseUrl}}/api/books/999
Authorization: Bearer {{authToken}}

### Delete book - Without admin role (should fail with 403)
# First login as a regular user (not admin), then try this:
DELETE {{baseUrl}}/api/books/1
Authorization: Bearer {{authToken}}

###############################################
# BOOK GET ENDPOINTS
###############################################

### Get book by ID
GET {{baseUrl}}/api/books/1
Authorization: Bearer {{authToken}}

### Get book by ID - Non-existent book (should return 404)
GET {{baseUrl}}/api/books/999
Authorization: Bearer {{authToken}}

###############################################
# BOOK SEARCH ENDPOINTS
###############################################

### Search books by keyword (searches in title, author, isbn, category)
GET {{baseUrl}}/api/books/search?keyword=978-0000000000
Authorization: Bearer {{authToken}}

### Search books by title
GET {{baseUrl}}/api/books/search?title=spring
Authorization: Bearer {{authToken}}

### Search books by author
GET {{baseUrl}}/api/books/search?author=Robert
Authorization: Bearer {{authToken}}

### Search books by ISBN
GET {{baseUrl}}/api/books/search?isbn=978-0-123456-78-9
Authorization: Bearer {{authToken}}

### Search books by category
GET {{baseUrl}}/api/books/search?category=programming
Authorization: Bearer {{authToken}}

### Search books with pagination and sorting
GET {{baseUrl}}/api/books/search?keyword=design&page=0&size=10&sortBy=author&sortDir=asc
Authorization: Bearer {{authToken}}

